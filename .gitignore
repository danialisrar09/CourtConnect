# ============================================================
# SPORT SLOT BOOKING SYSTEM — .gitignore
# ============================================================

# ─── Environment Variables (NEVER commit secrets) ───────────
.env
.env.*
!.env.example
backend/.env
frontend/.env

# ─── Node Dependencies ──────────────────────────────────────
node_modules/
backend/node_modules/
frontend/node_modules/
ai-service/__pycache__/

# ─── Build Outputs ──────────────────────────────────────────
/dist/
backend/dist/
frontend/dist/
frontend/build/
frontend/.vite/
build/
out/

# ─── Python AI Service ──────────────────────────────────────
ai-service/__pycache__/
ai-service/*.pyc
ai-service/*.pyo
ai-service/*.pyd
ai-service/.Python
ai-service/venv/
ai-service/.venv/
ai-service/env/
ai-service/*.egg-info/
ai-service/dist/
ai-service/build/
*.pkl            # Pickle model files (recommender_model.pkl)
*.joblib

# ─── Logs ───────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.pid
*.seed
*.pid.lock
backend/scripts/reports/

# ─── Cache ──────────────────────────────────────────────────
.cache/
.next/
.turbo/
.parcelcache/

# ─── Test Artifacts ─────────────────────────────────────────
coverage/
.nyc_output/

# ─── Editor & OS ────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
$RECYCLE.BIN/
~$*

# ─── Package Lock Alternatives ──────────────────────────────
yarn.lock
pnpm-lock.yaml

# ─── Backend-specific Temp / Debug Scripts ──────────────────
backend/debug-*.js
backend/test-*.js
backend/delete-*.js
backend/activateVenues.js
backend/seedVenues.js
backend/test-imports.js
backend/scripts/anchor-apply-log.txt

# ─── Frontend Build Artifacts ───────────────────────────────
frontend/build/
frontend/dist/

# ─── Root-level Docs / Diagrams (project-internal) ─────────
/ARCHITECTURE_COMPARISON.md
/ERD.jpg
/Test cases.txt
/TEST_CASES.md
/TEST_EXECUTION_TRACKER.md
/TEST_PHASE_STATUS.md
/UML.jpg
/*.md
/*.json
/*.docx

# ─── Stripe Webhook / Payment test fixtures ─────────────────
*.stripe-fixture.json
